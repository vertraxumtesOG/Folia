diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 6dfbaa9d68ec896132a6379a10699cb4a0794b56..e1d687862bae6ebc724d4358aded78e2670ecc7e 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -1680,6 +1680,26 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
     }
 
     // Folia start - region threading
+    public List<ServerPlayer> getLocalPlayers(final Predicate<? super ServerPlayer> selector) {
+        return this.getLocalPlayers(selector, Integer.MAX_VALUE);
+    }
+
+    // vanilla copy of above, getPlayers method, using getLocalPlayers from current world data
+    public List<ServerPlayer> getLocalPlayers(final Predicate<? super ServerPlayer> selector, final int maxResults) {
+        List<ServerPlayer> result = Lists.newArrayList();
+
+        for (ServerPlayer player : this.getLocalPlayers()) {
+            if (selector.test(player)) {
+                result.add(player);
+                if (result.size() >= maxResults) {
+                    return result;
+                }
+            }
+        }
+
+        return result;
+    }
+
     @Nullable
     public ServerPlayer getRandomLocalPlayer() {
         List<ServerPlayer> list = this.getLocalPlayers();
